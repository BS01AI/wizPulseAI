# MCP 服务器所需的环境变量
# 复制到 ~/.zshrc 或 ~/.zprofile 并填入真实值
#
# 设置后执行: source ~/.zshrc

# Notion MCP
export NOTION_MCP_TOKEN="ntn_your_notion_token_here"

# Supabase MCP
export SUPABASE_MCP_ACCESS_TOKEN="sbp_your_supabase_access_token_here"

# Stripe MCP (使用测试密钥或生产密钥)
export STRIPE_SECRET_KEY="sk_test_your_stripe_key_here"
